rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 承認済みのユーザーか（Firestore の users ドキュメントを参照する「クロスサービスルール」）。
    // 以前は「ログインしていれば誰でも」読み書き・削除でき、任意のGoogleアカウントでログインする
    // だけで、承認前の人でも添付ファイルの閲覧・アップロード・削除ができた。
    // ※ このルールを有効にするには、Cloud Storage のサービスエージェントに
    //   「Firebase Rules Firestore Service Agent」ロールが必要（初回のみ。handover.md 参照）。
    //   付与されていないとルールの評価が失敗し、添付ファイルは誰も使えなくなる
    function isApproved(teamId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/teams/$(teamId)/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/teams/$(teamId)/users/$(request.auth.uid)).data.status == 'approved';
    }

    match /teams/{teamId}/{allPaths=**} {
      allow read, delete: if isApproved(teamId);
      // 書き込みは1ファイル10MBまで（クライアント側チェックと二重の防御）
      allow create, update: if isApproved(teamId)
        && request.resource.size <= 10 * 1024 * 1024;
    }
  }
}
